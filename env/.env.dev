APP_NAME=fault-monitoring-system
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WORKER_METRICS_PORT=9000
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/fault_monitoring
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_REQUEST_TOPIC=request-topic
KAFKA_INFERENCE_TOPIC=inference-topic
KAFKA_RETRY_TOPIC_REQUEST=retry-topic
KAFKA_RETRY_TOPIC_DOWNSTREAM=retry-downstream-topic
KAFKA_DLQ_TOPIC=dlq-topic
KAFKA_DOWNSTREAM_TOPIC=downstream-topic
KAFKA_PARTITIONS_WORKER_TOPIC=8
KAFKA_PARTITIONS_DOWNSTREAM_TOPIC=1
WORKER_PROCESSOR_BACKEND=simulator
IDEMPOTENCY_TTL_SECONDS=3600
WORKER_PROCESSING_TTL_SECONDS=1800
RETRY_MAX_COUNT=3
RETRY_BACKOFF_SECONDS=1.0
RETRY_BACKOFF_MULTIPLIER=2.0
RETRY_BACKOFF_MAX_SECONDS=30.0
LOG_LEVEL=INFO
TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME_API=morphflow-api
OTEL_SERVICE_NAME_WORKER=morphflow-worker
API_HOST_PORT=8000
WORKER_METRICS_HOST_PORT=9000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6380
KAFKA_HOST_PORT=9092
KAFKA_EXTERNAL_HOST_PORT=29092
PROMETHEUS_HOST_PORT=9090
