APP_NAME=fault-monitoring-system
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WORKER_METRICS_PORT=9000
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/fault_monitoring
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_REQUEST_TOPIC=request-topic
IDEMPOTENCY_TTL_SECONDS=3600
WORKER_PROCESSING_TTL_SECONDS=1800
LOG_LEVEL=INFO
API_HOST_PORT=8000
WORKER_METRICS_HOST_PORT=9000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6380
KAFKA_HOST_PORT=9092
KAFKA_EXTERNAL_HOST_PORT=29092
PROMETHEUS_HOST_PORT=9090
